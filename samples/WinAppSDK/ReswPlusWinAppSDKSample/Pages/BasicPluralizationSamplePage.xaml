<Page
    x:Class="ReswPlusWinAppSDKSample.Pages.BasicPluralizationSamplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:ReswPlusWinAppSDKSample.Strings"
    Background="Transparent"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <StackPanel Style="{StaticResource PageIntroStyle}">
                <TextBlock Style="{StaticResource SectionDescriptionTextBlockStyle}" Text="Plural rules vary by language: some languages have more than two forms, and zero is not always plural. ReswPlus selects the correct .resw entry for the active language and generates a strongly typed method that accepts the quantity." />
            </StackPanel>

            <StackPanel Style="{StaticResource PartStyle}">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Select the correct plural form" />
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text=".resw entries:" />
                <StackPanel Style="{StaticResource SubPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="PluralizationTest_One" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Text="This is the singular form" />
                        <TextBlock Grid.Row="1" Text="PluralizationTest_Others" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="This is the plural form" />
                    </Grid>
                </StackPanel>
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Generated C#:" />
                <StackPanel Style="{StaticResource CodePanelStyle}">
                    <TextBlock Style="{StaticResource DescriptionTextBlockStyle}" Text="public static string PluralizationTest(double pluralizationReferenceNumber)&#x0a;{&#x0a;    return ReswPlus.ResourceLoaderExtension.GetPlural(_resourceLoader, &quot;PluralizationTest&quot;, pluralizationReferenceNumber, false);&#x0a;}" />
                </StackPanel>

                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="XAML usage:" />
                <StackPanel Style="{StaticResource CodePanelStyle}">
                    <TextBlock Style="{StaticResource DescriptionTextBlockStyle}" Text="&#x3C;TextBlock Text=&#x22;{x:Bind strings:Resources.PluralizationTest(1)}&#x22; /&#x3E;&#x0a;&#x3C;TextBlock Text=&#x22;{x:Bind strings:Resources.PluralizationTest(99)}&#x22; /&#x3E;" />
                </StackPanel>
                <TextBlock Style="{StaticResource ResultLabelTextBlockStyle}" Text="Result:" />

                <StackPanel Style="{StaticResource ResultPanelStyle}">
                    <TextBlock Text="{x:Bind strings:Resources.PluralizationTest(1)}" />
                    <TextBlock Text="{x:Bind strings:Resources.PluralizationTest(99)}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Style="{StaticResource PartStyle}">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Combine pluralization and formatting" />
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text=".resw entries:" />
                <StackPanel Style="{StaticResource SubPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="Bold" Text="Key" />
                        <TextBlock
                            Grid.Column="2"
                            FontWeight="Bold"
                            Text="Value" />
                        <TextBlock
                            Grid.Column="4"
                            FontWeight="Bold"
                            Text="Comment" />
                        <TextBlock Grid.Row="1" Text="MinutesLeft_One" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="{}{0} minute left" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Text="#Format[Plural]" />
                        <TextBlock Grid.Row="2" Text="MinutesLeft_Other" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Text="{}{0} minutes left" />
                    </Grid>
                </StackPanel>
                <TextBlock Style="{StaticResource SectionDescriptionTextBlockStyle}" Text="Mark the quantity argument as Plural in #Format[...]. ReswPlus uses that value both to select the language-specific form and to fill the format placeholder." />

                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Generated C#:" />
                <StackPanel Style="{StaticResource CodePanelStyle}">
                    <TextBlock Style="{StaticResource DescriptionTextBlockStyle}" Text="public static string MinutesLeft(double pluralCount)&#x0a;{&#x0a;    return string.Format(ReswPlus.ResourceLoaderExtension.GetPlural(_resourceLoader, &quot;MinutesLeft&quot;, pluralCount, false), pluralCount);&#x0a;}" />
                </StackPanel>

                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="XAML usage:" />
                <StackPanel Style="{StaticResource CodePanelStyle}">
                    <TextBlock Style="{StaticResource DescriptionTextBlockStyle}" Text="&#x3C;Slider x:Name=&#x22;MinutesSlider&#x22; /&#x3E;&#x0a;&#x3C;TextBlock Text=&#x22;{x:Bind strings:Resources.MinutesLeft(MinutesSlider.Value), Mode=OneWay}&#x22; /&#x3E;" />
                </StackPanel>
                <TextBlock Style="{StaticResource ResultLabelTextBlockStyle}" Text="Result:" />

                <StackPanel Style="{StaticResource ResultPanelStyle}">
                    <Slider
                        x:Name="MinutesSlider"
                        Maximum="10"
                        Minimum="0"
                        Value="1" />
                    <TextBlock Text="{x:Bind strings:Resources.MinutesLeft(MinutesSlider.Value), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
