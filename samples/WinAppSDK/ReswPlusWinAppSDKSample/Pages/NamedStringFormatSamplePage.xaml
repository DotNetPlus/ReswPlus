<Page
    x:Class="ReswPlusWinAppSDKSample.Pages.NamedStringFormatSamplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:ReswPlusWinAppSDKSample.Strings"
    Background="Transparent"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <StackPanel Style="{StaticResource PageIntroStyle}">
                <TextBlock Style="{StaticResource SectionDescriptionTextBlockStyle}" Text="Name formatting parameters in the #Format[...] comment, for example #Format[Int32 temperature, String city]. ReswPlus uses those names in the generated method, making call sites and IntelliSense easier to understand." />
            </StackPanel>

            <StackPanel Style="{StaticResource PartStyle}">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Generate methods with named parameters" />
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text=".resw entries:" />
                <StackPanel Style="{StaticResource SubPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="Bold" Text="Key" />
                        <TextBlock
                            Grid.Column="2"
                            FontWeight="Bold"
                            Text="Value" />
                        <TextBlock
                            Grid.Column="4"
                            FontWeight="Bold"
                            Text="Comment" />
                        <TextBlock Grid.Row="1" Text="ForecastAnnouncement" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="The current temperature in {2} is {0}°F ({1}°C)" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Text="#Format[Int32 tempFahrenheit, Int32 tempCelsius, String city]" />
                    </Grid>
                </StackPanel>
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Generated C#:" />
                <StackPanel Style="{StaticResource CodePanelStyle}">
                    <TextBlock Style="{StaticResource DescriptionTextBlockStyle}" Text="public static string ForecastAnnouncement(int tempFahrenheit, int tempCelsius, string city)&#x0a;{&#x0a; return string.Format(_resourceLoader.GetString(&quot;ForecastAnnouncement&quot;), tempFahrenheit, tempCelsius, city);&#x0a;}" />
                </StackPanel>

                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="XAML usage:" />
                <StackPanel Style="{StaticResource CodePanelStyle}">
                    <TextBlock Style="{StaticResource DescriptionTextBlockStyle}" Text="&#x3C;TextBlock Text=&#x22;{x:Bind strings:Resources.ForecastAnnouncement(77, 25, &#x27;Paris&#x27;)}&#x22; /&#x3E;" />
                </StackPanel>
                <TextBlock Style="{StaticResource ResultLabelTextBlockStyle}" Text="Result:" />

                <StackPanel Style="{StaticResource ResultPanelStyle}">
                    <TextBlock Text="{x:Bind strings:Resources.ForecastAnnouncement(77, 25, 'Paris')}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
