<Application
    x:Class="ReswPlusUWPSample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ReswPlusUWPSample.Controls"
    xmlns:converters="using:ReswPlusUWPSample.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush
                        x:Key="SampleShellBackgroundBrush"
                        BackgroundSource="HostBackdrop"
                        FallbackColor="#FFF3F3F3"
                        TintColor="#FFF3F3F3"
                        TintOpacity="0.72" />
                    <SolidColorBrush x:Key="SampleCardBackgroundBrush" Color="#FFF7F7F8" />
                    <SolidColorBrush x:Key="SampleCardBorderBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="SampleCodeBackgroundBrush" Color="#FFF8F7FA" />
                    <SolidColorBrush x:Key="SampleCodeBorderBrush" Color="#267B54C0" />
                    <SolidColorBrush x:Key="SampleIntroBackgroundBrush" Color="#0D7B54C0" />
                    <SolidColorBrush x:Key="SamplePrimaryTextBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="SampleResultBackgroundBrush" Color="#0D7B54C0" />
                    <SolidColorBrush x:Key="SampleResultBorderBrush" Color="#807B54C0" />
                    <SolidColorBrush x:Key="SampleResultTextBrush" Color="#FF6846A3" />
                    <SolidColorBrush x:Key="SampleSecondaryTextBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="SampleSectionBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SampleSectionBorderBrush" Color="#18000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush
                        x:Key="SampleShellBackgroundBrush"
                        BackgroundSource="HostBackdrop"
                        FallbackColor="#FF202020"
                        TintColor="#FF202020"
                        TintOpacity="0.72" />
                    <SolidColorBrush x:Key="SampleCardBackgroundBrush" Color="#FF202020" />
                    <SolidColorBrush x:Key="SampleCardBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="SampleCodeBackgroundBrush" Color="#FF211F24" />
                    <SolidColorBrush x:Key="SampleCodeBorderBrush" Color="#667B54C0" />
                    <SolidColorBrush x:Key="SampleIntroBackgroundBrush" Color="#267B54C0" />
                    <SolidColorBrush x:Key="SamplePrimaryTextBrush" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="SampleResultBackgroundBrush" Color="#1A7B54C0" />
                    <SolidColorBrush x:Key="SampleResultBorderBrush" Color="#B37B54C0" />
                    <SolidColorBrush x:Key="SampleResultTextBrush" Color="#FFC2A5F5" />
                    <SolidColorBrush x:Key="SampleSecondaryTextBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="SampleSectionBackgroundBrush" Color="#FF292929" />
                    <SolidColorBrush x:Key="SampleSectionBorderBrush" Color="#26FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="SystemAccentColor">#7B54C0</Color>

            <Style TargetType="TextBlock">
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="PageContentStyle" TargetType="StackPanel">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="32,24,32,48" />
                <Setter Property="MaxWidth" Value="1060" />
            </Style>

            <Style x:Key="SectionDescriptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SampleSecondaryTextBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style x:Key="PageIntroStyle" TargetType="StackPanel">
                <Setter Property="Background" Value="{ThemeResource SampleIntroBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Padding" Value="20,16" />
            </Style>

            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SamplePrimaryTextBrush}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="SubPanelStyle" TargetType="StackPanel">
                <Setter Property="Background" Value="{ThemeResource SampleCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SampleCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="DescriptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="controls:SyntaxHighlighter.IsEnabled" Value="True" />
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="LineHeight" Value="21" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style
                x:Key="CodePanelStyle"
                BasedOn="{StaticResource SubPanelStyle}"
                TargetType="StackPanel">
                <Setter Property="Background" Value="{ThemeResource SampleCodeBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SampleCodeBorderBrush}" />
            </Style>

            <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SampleSecondaryTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>

            <Style
                x:Key="ResultLabelTextBlockStyle"
                BasedOn="{StaticResource LabelTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SampleResultTextBrush}" />
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>

            <Style
                x:Key="ResultPanelStyle"
                BasedOn="{StaticResource SubPanelStyle}"
                TargetType="StackPanel">
                <Setter Property="Background" Value="{ThemeResource SampleResultBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SampleResultBorderBrush}" />
            </Style>

            <Style x:Key="PartStyle" TargetType="StackPanel">
                <Setter Property="Background" Value="{ThemeResource SampleSectionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SampleSectionBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <converters:ToUpperCaseConverter x:Key="ToUpperCaseConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
