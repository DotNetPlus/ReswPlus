<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>ReswPlus</Title>
    <PackageId>ReswPlus</PackageId>
    <Authors>Rudy Huyn</Authors>
    <Description>A C# source generator for strongly typed .resw resources, formatting, pluralization, macros, and variants in UWP and WinUI apps.</Description>
    <PackageProjectUrl>https://github.com/DotNetPlus/ReswPlus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetPlus/ReswPlus.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageCopyright>Copyright 2019-2026 Rudy Huyn and contributors</PackageCopyright>
    <PackageTags>dotnet localization resw source-generator uwp winui plural pluralization</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Roslyn-based generation, resource diagnostics, and corrected CLDR plural rules. See https://github.com/DotNetPlus/ReswPlus/blob/v$(Version)/CHANGELOG.md.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Include the built DLL as an analyzer -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs"/>
    <!-- Package metadata -->
    <None Include="$(MSBuildThisFileDirectory)Icon.png" Pack="true" PackagePath=""/>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath=""/>
    <!-- Include target files for MSBuild -->
    <None Include="$(MSBuildThisFileDirectory)ReswPlus.targets" PackagePath="buildTransitive/" Pack="true"/>
    <None Include="$(MSBuildThisFileDirectory)ReswPlus.targets" PackagePath="build/" Pack="true"/>
  </ItemGroup>
</Project>